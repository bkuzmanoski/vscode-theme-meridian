{
  "$schema": "vscode://schemas/color-theme",
  "name": "Meridian",
  "tokenColors": [
    {
      "scope": [],
      "settings": {
        "foreground": "#2e363c"
      }
    },
    {
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": {
        "foreground": "#2e363c",
        "fontStyle": ""
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#839099",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.tag.sgml.doctype",
        "meta.diff.header",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#839099"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "support.other",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#9f5090"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "keyword.other.special-method",
        "storage.type.method"
      ],
      "settings": {
        "foreground": "#3378a3"
      }
    },
    {
      "scope": [
        "entity.name.variable.property",
        "meta.object-literal.key",
        "meta.object.member",
        "meta.property.object",
        "support.type.property.name",
        "support.variable.property",
        "variable.object.property",
        "variable.other.constant.property",
        "variable.other.member",
        "variable.other.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#6a519e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#417b81"
      }
    },
    {
      "scope": ["variable", "meta.import constant", "support.variable"],
      "settings": {
        "foreground": "#2e363c"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "meta.preprocessor.numeric",
        "constant.other.color punctuation"
      ],
      "settings": {
        "foreground": "#9f5a38"
      }
    },
    {
      "scope": [
        "string",
        "constant.character",
        "markup.raw",
        "markup.inline.raw",
        "meta.preprocessor.string"
      ],
      "settings": {
        "foreground": "#446f53"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#417b81"
      }
    },
    {
      "scope": ["string.unquoted.argument"],
      "settings": {
        "foreground": "#2e363c"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#2e363c"
      }
    },
    {
      "scope": [
        "keyword.operator.type.annotation",
        "meta.tag.attributes keyword.operator.assignment",
        "keyword.operator.assignment.shell"
      ],
      "settings": {
        "foreground": "#637079"
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "constant.character.escape"],
      "settings": {
        "foreground": "#637079"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded",
        "punctuation.definition.subshell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#9f5090"
      }
    },
    {
      "scope": ["entity.name.type.module", "support.type.property-name"],
      "settings": {
        "foreground": "#2e363c"
      }
    },
    {
      "scope": ["invalid"],
      "settings": {
        "foreground": "#b03645"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.nesting.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "punctuation.definition.tag",
        "punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#9f5090"
      }
    },
    {
      "scope": [
        "meta.selector.pseudo-class",
        "meta.selector.pseudo-element",
        "meta.selector.pseudo-class punctuation.definition.entity",
        "meta.selector.pseudo-element punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#637079"
      }
    },
    {
      "scope": ["entity.other.keyframe-offset"],
      "settings": {
        "foreground": "#637079"
      }
    },
    {
      "scope": ["keyword.other.unit"],
      "settings": {
        "foreground": "#9f5a38"
      }
    },
    {
      "scope": ["markup.heading", "markup.bold", "strong"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic", "emphasis"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading markup.italic",
        "markup.bold markup.italic",
        "markup.italic markup.bold",
        "strong emphasis",
        "emphasis strong"
      ],
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "scope": ["string.other.link", "markup.link"],
      "settings": {
        "foreground": "#3378a3"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#446f53"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#b03645"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#3378a3"
      }
    }
  ],
